if [[ $size_of_the_list_of_extensions_to_install -gt 0 ]]; then
  # install extensions
  action='i'
  create_a_list_of_parameters list_of_extensions_to_install $action parameters
  show_list parameters 'parameters'
  #code_launcher parameters
fi
if [[ $size_of_the_list_of_extensions_to_remove -gt 0 ]]; then
  # remove extensions
  action='r'
  create_a_list_of_parameters list_of_extensions_to_remove $action parameters
  show_list parameters 'parameters'
  #code_launcher parameters
fi
code_launcher parameters
if [[ $size_of_the_list_of_extensions_to_install -eq 0 ]] && [[ $size_of_the_list_of_extensions_to_remove -eq 0 ]]; then
  # update extensions
  action='u'
  # create_a_list_of_parameters list_of_installed_extensions $action parameters
  # show_list parameters 'parameters'
  parameters=(--update-extensions)
  code_launcher parameters
fi
#code_launcher parameters
exit 0
